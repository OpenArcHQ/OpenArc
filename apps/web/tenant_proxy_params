proxy_http_version 1.1;

# Disable the default blanket request-header passthrough. Only the explicit
# allowlist below reaches the organization read API; no Authorization,
# CSRF/source/proxy/metrics secret or forwarded peer header is forwarded.
proxy_pass_request_headers off;
proxy_set_header Host $proxy_host;
proxy_set_header Cookie $http_cookie;
proxy_set_header Origin $http_origin;
proxy_set_header X-OpenArc-Client $http_x_openarc_client;
proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
proxy_set_header Sec-Fetch-Mode $http_sec_fetch_mode;
proxy_set_header Sec-Fetch-Dest $http_sec_fetch_dest;
proxy_set_header Accept $http_accept;

proxy_hide_header Strict-Transport-Security;

# Verified upstream TLS/SNI/trust is inherited from the enclosing server
# template, which expands API_UPSTREAM_SNI / API_TRUST_BUNDLE at startup.
proxy_ssl_server_name on;
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;

proxy_connect_timeout 3s;
proxy_send_timeout 10s;
proxy_read_timeout 10s;

# No automatic upstream retry, no response caching or spooling to disk.
proxy_next_upstream off;
# Request buffering is off so a body-bearing request (rejected in the rewrite
# phase before proxy_pass) is never spooled to disk. After that explicit
# rejection, the request body is not forwarded either.
proxy_request_buffering off;
proxy_pass_request_body off;
proxy_buffering off;
proxy_max_temp_file_size 0;
