proxy_http_version 1.1;

# Disable the default blanket request-header passthrough. Only the explicit
# allowlist below reaches the organization write API; no Authorization,
# source/proxy/metrics secret or forwarded peer header is forwarded. The
# transient CSRF token and the idempotency key are forwarded ONLY on a write.
proxy_pass_request_headers off;
proxy_set_header Host $proxy_host;
proxy_set_header Cookie $http_cookie;
proxy_set_header Origin $http_origin;
proxy_set_header X-OpenArc-Client $http_x_openarc_client;
proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
proxy_set_header Sec-Fetch-Mode $http_sec_fetch_mode;
proxy_set_header Sec-Fetch-Dest $http_sec_fetch_dest;
proxy_set_header Accept $http_accept;
proxy_set_header Content-Type $http_content_type;
proxy_set_header X-OpenArc-CSRF $http_x_openarc_csrf;
proxy_set_header Idempotency-Key $http_idempotency_key;

proxy_hide_header Strict-Transport-Security;

# Verified upstream TLS/SNI/trust is inherited from the enclosing server
# template, which expands API_UPSTREAM_SNI / API_TRUST_BUNDLE at startup.
proxy_ssl_server_name on;
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;

proxy_connect_timeout 3s;
proxy_send_timeout 10s;
proxy_read_timeout 10s;

# No automatic upstream retry, no response caching or spooling to disk.
proxy_next_upstream off;
# Request buffering is off so no body is spooled to disk; the finite 8k
# location body limit is authoritative. A write body IS forwarded (this file is
# used only by the write named locations).
proxy_request_buffering off;
proxy_pass_request_body on;
proxy_buffering off;
proxy_max_temp_file_size 0;
