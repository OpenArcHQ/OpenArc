{
  "name": "@openarc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/server.js",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:postgres": "vitest run -c vitest.postgres.config.ts"
  },
  "dependencies": {
    "@openarc/shared": "workspace:*",
    "@redis/client": "6.2.1",
    "@simplewebauthn/server": "14.0.1",
    "fastify": "5.12.1",
    "viem": "2.56.3",
    "zod": "4.5.4",
    "@openarc/db": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
