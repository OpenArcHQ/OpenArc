# Shared build identity
COMMIT_SHA=local

# API shell. M00 has no live Arc provider call.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# Web build identity and same-origin API path.
VITE_COMMIT_SHA=local
VITE_API_BASE_URL=/v1
VITE_ENCRYPTED_WORKSPACE_ENABLED=false
VITE_API_BOUNDARY_ENABLED=false
API_BOUNDARY_ENABLED=false
